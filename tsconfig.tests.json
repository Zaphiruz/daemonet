{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "allowJs": true
  },
  "include": [
    "packages/*/test/**/*.ts",
    "apps/*/test/**/*.ts",
    "packages/sandbox/verify/**/*.ts",
    "examples/*/test/**/*.ts"
  ],
  "exclude": [
    "apps/frontend/**"
  ]
}
