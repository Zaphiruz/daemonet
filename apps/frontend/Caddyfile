# Caddy drops an incoming X-Forwarded-For unless the peer is a trusted proxy. Trust ONLY LC2
# (static 192.168.40.11): any other host on the VLAN that reaches this port directly has its
# X-Forwarded-For discarded, so client IPs cannot be spoofed.
# Chain: Cloudflare edge -> cloudflared (LC2, 127.0.0.1) -> nginx (LC2) -> Caddy -> sim/api,
# which is why both run with TRUST_PROXY_HOPS=3.
{
  servers {
    trusted_proxies static 192.168.40.11/32
  }
}

(security_headers) {
  X-Content-Type-Options "nosniff"
  Referrer-Policy "strict-origin-when-cross-origin"
  X-Frame-Options "DENY"
}

# Policy of the app's own pages (index.html, assets, workers). No 'unsafe-inline' for scripts and no
# data: for scripts; Monaco needs inline styles, same-origin workers, data:/blob: images and its font.
# style-src keeps 'unsafe-inline' and img-src keeps data: blob: only because Monaco injects <style>
# elements and draws its glyph/codicon images from data: URIs; neither can run script. The sandbox
# document below has its own strict policy (SANDBOX_CSP) and allows neither.
# connect-src lists the WebSocket scheme explicitly because older browsers do not map 'self' to ws(s).
(host_csp) {
  Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; frame-src 'self'; connect-src 'self' ws://{host} wss://{host}; object-src 'none'; base-uri 'none'; form-action 'self'"
}

:80 {
  encode gzip zstd

  # The game protocol and its readiness probe. WebSocket upgrades pass through reverse_proxy as-is.
  handle /ws* {
    reverse_proxy sim:3000
  }

  # The web API (login, session, tickets): never cached by browsers or intermediaries.
  handle /api/* {
    header {
      import security_headers
      Cache-Control "no-store"
    }
    reverse_proxy api:3000
  }

  # The player-script sandbox (packages/sandbox, SANDBOX_CSP). Served without auth, framed only by this
  # origin (SAMEORIGIN; the iframe itself is sandboxed to an opaque origin), and the strict SANDBOX_CSP
  # header is what actually applies (the meta tag in the page is only a fallback). This string must equal
  # SANDBOX_CSP in packages/sandbox/src/document.ts; apps/frontend/test/caddyfile.test.ts pins it.
  handle /sandbox.html {
    root * /srv
    header {
      X-Content-Type-Options "nosniff"
      Referrer-Policy "no-referrer"
      X-Frame-Options "SAMEORIGIN"
      Cache-Control "no-cache"
      Content-Security-Policy "default-src 'none'; script-src 'self' blob:; worker-src blob:; connect-src 'none'; base-uri 'none'; form-action 'none'; webrtc 'block'"
    }
    file_server
  }

  # The sandbox bootstrap, worker and SDK: static, ours, never user content. No SPA fallback here, a
  # missing file must 404 rather than return index.html.
  handle /sandbox/* {
    root * /srv
    header {
      X-Content-Type-Options "nosniff"
      Referrer-Policy "no-referrer"
      Cache-Control "no-cache"
    }
    file_server
  }

  # Hashed build output is immutable (SP2 client); everything else must revalidate.
  handle /assets/* {
    root * /srv
    header {
      import security_headers
      import host_csp
      Cache-Control "public, max-age=31536000, immutable"
    }
    file_server
  }

  handle {
    root * /srv
    header {
      import security_headers
      import host_csp
      Cache-Control "no-cache"
    }
    try_files {path} /index.html
    file_server
  }
}
