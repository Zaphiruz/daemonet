generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Location {
  RAM
  DISK
}

model Operator {
  id             String   @id @default(uuid())
  sub            String   @unique
  name           String?  @unique
  starterClaimed Boolean  @default(false)
  bits           BigInt   @default(0)
  /// Disk slots owned (256 + 32 per expansion, max 512)
  diskCapacity   Int      @default(256)
  subnet         String   @default("lo")
  x              Float
  y              Float
  /// item id -> count
  inventory      Json     @default("{}")
  isAdmin        Boolean  @default(false)
  /// chat mute (admin or automatic), null = not muted
  mutedUntil     DateTime?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  daemons        Daemon[]
  sessions       Session[]
  tickets        WsTicket[]
  script         Script?
  scriptVersions ScriptVersion[]
}

/// Browser sessions (cookie daemonet_sid). The cookie value is never stored, only its SHA-256.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  groups     String[]
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([operatorId])
  @@index([expiresAt])
}

/// Single-use, 60-second tickets that let a browser authenticate its WebSocket without a cookie.
model WsTicket {
  tokenHash  String   @id
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

/// The operator's current main script.
model Script {
  operatorId String   @id
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  source     String
  version    Int
  updatedAt  DateTime @updatedAt
}

/// The last 16 saved versions of the main script.
model ScriptVersion {
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  version    Int
  source     String
  createdAt  DateTime @default(now())

  @@id([operatorId, version])
}

model Daemon {
  id                 String   @id
  operatorId         String
  operator           Operator @relation(fields: [operatorId], references: [id])
  species            String
  level              Int
  xp                 Int
  nature             Int
  traitSlot          Int
  /// 8 values in STAT_KEYS order
  ivs                Int[]
  bonus              Int[]
  clean              Boolean
  signature          Int
  hp                 Int
  energy             Int
  moves              String[]
  crashed            Boolean
  location           Location
  slot               Int
  heldItem           String?
  /// listing:<id> or trade:<id> while on the Exchange (SP5): cannot be loaded into RAM
  lockedBy           String?
  patched            Boolean  @default(false)
  /// lifetime move uses per type, TYPES order (16)
  moveTypeUses       Int[]
  crashes            Int      @default(0)
  arenaWins          Int      @default(0)
  /// [{ at, kind: captured|evolved|clean|signature|patched, detail }]
  history            Json     @default("[]")
  // capture log
  originalOperatorId String
  capturedAt         DateTime
  captureSubnet      String
  captureTool        String
  spawnSeedId        String
  spawnIndex         Int?

  @@unique([operatorId, location, slot])
  @@index([operatorId])
  @@index([originalOperatorId])
}

model SubnetSeed {
  /// 8 hex chars; prefixes every id the world generates
  id        String   @id
  subnet    String
  seed      String
  startedAt DateTime @default(now())
}

/// Every bits change (SP3b spec §5): the balance on Operator is the sum of an operator's deltas.
model BitsLedger {
  id         String   @id @default(uuid())
  /// Insertion order (rows written within the same millisecond keep their order)
  seq        BigInt   @default(autoincrement())
  operatorId String
  delta      BigInt
  /// shop | disk | craft | ticket (the sim's store intents, SIM_LEDGER_REASONS) | admin (admin and dev grants) | org
  /// (org creation and tag change) | rename (operator rename)
  reason     String
  ref        String?
  at         DateTime @default(now())

  @@index([operatorId, at])
  @@index([operatorId, seq])
  @@index([at])
}

/// Items an operator has deposited for trading (SP5 spec §4). The api owns these rows; live inventory stays with the sim.
model ExchangeVault {
  operatorId String
  item       String
  qty        Int

  @@id([operatorId, item])
}

/// Decompiled daemons keep their capture log here (never loadable again).
model DaemonArchive {
  id                 String   @id
  operatorId         String
  species            String
  level              Int
  xp                 Int
  nature             Int
  traitSlot          Int
  ivs                Int[]
  bonus              Int[]
  clean              Boolean
  signature          Int
  moves              String[]
  heldItem           String?
  patched            Boolean
  moveTypeUses       Int[]
  crashes            Int
  arenaWins          Int
  history            Json
  originalOperatorId String
  capturedAt         DateTime
  captureSubnet      String
  captureTool        String
  spawnSeedId        String
  spawnIndex         Int?
  archivedAt         DateTime @default(now())
  /// decompiled
  reason             String

  @@index([operatorId])
  @@index([originalOperatorId])
}

enum IncidentOutcome {
  OPEN
  CLEARED
  EXPIRED
}

/// Incidents (SP4 spec §8): one row per boss window; participants are filled when it is cleared.
model Incident {
  id           String          @id
  n            Int
  species      String
  openedAt     DateTime        @default(now())
  endsAt       DateTime
  closedAt     DateTime?
  outcome      IncidentOutcome @default(OPEN)
  /// [{ operatorId, name, damage, share, reward }]
  participants Json            @default("[]")

  @@index([openedAt])
}

enum OrgRank {
  OWNER
  OFFICER
  MEMBER
}

/// Orgs (SP4 spec §7): name, 4-character tag, up to 64 members.
model Org {
  id        String      @id
  name      String      @unique
  tag       String      @unique
  ownerId   String
  createdAt DateTime    @default(now())
  members   OrgMember[]
  invites   OrgInvite[]
}

model OrgMember {
  operatorId String   @id
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rank       OrgRank  @default(MEMBER)
  joinedAt   DateTime @default(now())

  @@index([orgId])
}

model OrgInvite {
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  operatorId String
  byId       String
  at         DateTime @default(now())

  @@id([orgId, operatorId])
  @@index([operatorId])
}

/// Chat (SP4 spec §5): 7 days of history, soft-deleted by admins.
model ChatMessage {
  id         String    @id
  /// subnet:<id> | cluster:<id> | org:<id> | dm:<operatorId>
  channel    String
  operatorId String
  /// for dm channels: the recipient
  toId       String?
  text       String
  at         DateTime  @default(now())
  deletedAt  DateTime?

  @@index([channel, at])
  @@index([operatorId, at])
}

model ChatBlock {
  blockerId String
  blockedId String
  at        DateTime @default(now())

  @@id([blockerId, blockedId])
}

enum FilterKind {
  WORD
  REGEX
}

enum FilterAction {
  BLOCK
  MASK
}

/// Admin-added chat filter terms (the default list ships in rules).
model ChatFilterTerm {
  id      String       @id @default(uuid())
  pattern String
  kind    FilterKind
  action  FilterAction
  addedBy String
  at      DateTime     @default(now())
}

model ChatFilterHit {
  id         String   @id @default(uuid())
  operatorId String
  channel    String
  text       String
  term       String
  at         DateTime @default(now())

  @@index([operatorId, at])
}

enum ReportReason {
  SPAM
  HARASSMENT
  CHEATING
  NAME
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

/// Player reports (SP4 spec §5.2); resolved by admins in-game, never linked out.
model Report {
  id         String       @id @default(uuid())
  reporterId String
  targetId   String
  messageId  String?
  reason     ReportReason
  note       String       @default("")
  status     ReportStatus @default(OPEN)
  resolvedBy String?
  resolvedAt DateTime?
  action     String?
  at         DateTime     @default(now())

  @@unique([reporterId, messageId])
  @@index([status, at])
  @@index([reporterId, at])
}

enum TicketStatus {
  OPEN
  DONE
  ABANDONED
}

/// A helpdesk ticket an operator accepted (SP3b spec §7); the board itself is generated from rules.
model Ticket {
  id          String       @id
  operatorId  String
  /// UTC day of the board, YYYY-MM-DD
  day         String
  subnet      String
  index       Int
  kind        String
  params      Json
  target      Int
  reward      Int
  progress    Int          @default(0)
  status      TicketStatus @default(OPEN)
  acceptedAt  DateTime     @default(now())
  completedAt DateTime?

  @@unique([operatorId, day, subnet, index])
  @@index([operatorId, status])
  @@index([operatorId, day])
}

/// Codex research: one point per capture of any form of a bestiary line (design §7.2).
model Research {
  operatorId String
  line       Int
  points     Int    @default(0)

  @@id([operatorId, line])
}

/// First operator to meet a hidden evolution requirement (reveals it in the Codex).
model Discovery {
  formId       String   @id
  operatorId   String
  discoveredAt DateTime @default(now())
}

model AppliedAction {
  key       String   @id
  kind      String
  createdAt DateTime @default(now())
}
