generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Location {
  RAM
  DISK
}

model Operator {
  id             String   @id @default(uuid())
  sub            String   @unique
  name           String?  @unique
  starterClaimed Boolean  @default(false)
  bits           BigInt   @default(0)
  /// Disk slots owned (256 + 32 per expansion, max 512)
  diskCapacity   Int      @default(256)
  subnet         String   @default("lo")
  x              Float
  y              Float
  /// item id -> count
  inventory      Json     @default("{}")
  isAdmin        Boolean  @default(false)
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  daemons        Daemon[]
  sessions       Session[]
  tickets        WsTicket[]
  script         Script?
  scriptVersions ScriptVersion[]
}

/// Browser sessions (cookie daemonet_sid). The cookie value is never stored, only its SHA-256.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  groups     String[]
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([operatorId])
  @@index([expiresAt])
}

/// Single-use, 60-second tickets that let a browser authenticate its WebSocket without a cookie.
model WsTicket {
  tokenHash  String   @id
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

/// The operator's current main script.
model Script {
  operatorId String   @id
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  source     String
  version    Int
  updatedAt  DateTime @updatedAt
}

/// The last 16 saved versions of the main script.
model ScriptVersion {
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  version    Int
  source     String
  createdAt  DateTime @default(now())

  @@id([operatorId, version])
}

model Daemon {
  id                 String   @id
  operatorId         String
  operator           Operator @relation(fields: [operatorId], references: [id])
  species            String
  level              Int
  xp                 Int
  nature             Int
  traitSlot          Int
  /// 8 values in STAT_KEYS order
  ivs                Int[]
  bonus              Int[]
  clean              Boolean
  signature          Int
  hp                 Int
  energy             Int
  moves              String[]
  crashed            Boolean
  location           Location
  slot               Int
  heldItem           String?
  patched            Boolean  @default(false)
  /// lifetime move uses per type, TYPES order (16)
  moveTypeUses       Int[]
  crashes            Int      @default(0)
  arenaWins          Int      @default(0)
  /// [{ at, kind: captured|evolved|clean|signature|patched, detail }]
  history            Json     @default("[]")
  // capture log
  originalOperatorId String
  capturedAt         DateTime
  captureSubnet      String
  captureTool        String
  spawnSeedId        String
  spawnIndex         Int?

  @@unique([operatorId, location, slot])
  @@index([operatorId])
}

model SubnetSeed {
  /// 8 hex chars; prefixes every id the world generates
  id        String   @id
  subnet    String
  seed      String
  startedAt DateTime @default(now())
}

/// Every bits change (SP3b spec §5): the balance on Operator is the sum of an operator's deltas.
model BitsLedger {
  id         String   @id @default(uuid())
  /// Insertion order (rows written within the same millisecond keep their order)
  seq        BigInt   @default(autoincrement())
  operatorId String
  delta      BigInt
  /// ticket | shop | disk | craft | admin
  reason     String
  ref        String?
  at         DateTime @default(now())

  @@index([operatorId, at])
  @@index([at])
}

/// Decompiled daemons keep their capture log here (never loadable again).
model DaemonArchive {
  id                 String   @id
  operatorId         String
  species            String
  level              Int
  xp                 Int
  nature             Int
  traitSlot          Int
  ivs                Int[]
  bonus              Int[]
  clean              Boolean
  signature          Int
  moves              String[]
  heldItem           String?
  patched            Boolean
  moveTypeUses       Int[]
  crashes            Int
  arenaWins          Int
  history            Json
  originalOperatorId String
  capturedAt         DateTime
  captureSubnet      String
  captureTool        String
  spawnSeedId        String
  spawnIndex         Int?
  archivedAt         DateTime @default(now())
  /// decompiled
  reason             String

  @@index([operatorId])
}

enum TicketStatus {
  OPEN
  DONE
  ABANDONED
}

/// A helpdesk ticket an operator accepted (SP3b spec §7); the board itself is generated from rules.
model Ticket {
  id          String       @id
  operatorId  String
  /// UTC day of the board, YYYY-MM-DD
  day         String
  subnet      String
  index       Int
  kind        String
  params      Json
  target      Int
  reward      Int
  progress    Int          @default(0)
  status      TicketStatus @default(OPEN)
  acceptedAt  DateTime     @default(now())
  completedAt DateTime?

  @@unique([operatorId, day, subnet, index])
  @@index([operatorId, status])
  @@index([operatorId, day])
}

/// Codex research: one point per capture of any form of a bestiary line (design §7.2).
model Research {
  operatorId String
  line       Int
  points     Int    @default(0)

  @@id([operatorId, line])
}

/// First operator to meet a hidden evolution requirement (reveals it in the Codex).
model Discovery {
  formId       String   @id
  operatorId   String
  discoveredAt DateTime @default(now())
}

model AppliedAction {
  key       String   @id
  kind      String
  createdAt DateTime @default(now())
}
